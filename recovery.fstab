# Android fstab for Xiaomi beryl / OrangeFox vendor_boot recovery.
# Stock Android 14 filesystem + FBE configuration.

# ============================================================
# Dynamic partitions
# ============================================================

/system erofs system flags=display=system;logical;slotselect
/system_ext erofs system_ext flags=display=system_ext;logical;slotselect
/vendor erofs vendor flags=display=vendor;logical;slotselect
/product erofs product flags=display=product;logical;slotselect
/vendor_dlkm erofs vendor_dlkm flags=display=vendor_dlkm;logical;slotselect
/odm_dlkm erofs odm_dlkm flags=display=odm_dlkm;logical;slotselect

# MIUI extension partition
/mnt/vendor/mi_ext erofs mi_ext flags=display=mi_ext;logical;slotselect

# ============================================================
# Physical boot / AVB partitions
# ============================================================

/boot emmc /dev/block/by-name/boot flags=display=boot;slotselect
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=display=vendor_boot
/vbmeta emmc /dev/block/by-name/vbmeta flags=display=vbmeta
/vbmeta_vendor emmc /dev/block/by-name/vbmeta_vendor flags=display=vbmeta_vendor;slotselect
/vbmeta_system emmc /dev/block/by-name/vbmeta_system flags=display=vbmeta_system;slotselect
/dtbo emmc /dev/block/by-name/dtbo flags=display=dtbo
/misc emmc /dev/block/by-name/misc flags=display=misc

# ============================================================
# Other physical partitions
# ============================================================

/persist ext4 /dev/block/by-name/persist flags=display=persist
/nvdata ext4 /dev/block/by-name/nvdata flags=display=nvdata
/nvcfg ext4 /dev/block/by-name/nvcfg flags=display=nvcfg
/nvram emmc /dev/block/by-name/nvram flags=display=nvram
/proinfo emmc /dev/block/by-name/proinfo flags=display=proinfo

# ============================================================
# Metadata
# ============================================================

/metadata ext4 /dev/block/by-name/metadata \
    noatime,nosuid,nodev,discard \
    wait,check,formattable,first_stage_mount

# ============================================================
# Userdata / FBE
# ============================================================

/data f2fs /dev/block/by-name/userdata \
    flags=display=data,inlinecrypt,\
fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,\
keydirectory=/metadata/vold/metadata_encryption,\
gc_merge,atgc,age_extent_cache,noatime,nosuid,nodev,discard,\
noflush_merge,fsync_mode=nobarrier,reserve_root=134217,\
resgid=1065,wait,check,formattable,quota,latemount,resize,\
reservedsize=128m,checkpoint=fs,fsverity

# ============================================================
# Removable storage
# ============================================================

auto vfat /devices/platform/soc/mt_usb* \
    flags=display=USB-OTG;storage;removable
