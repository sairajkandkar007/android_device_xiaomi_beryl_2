#
# Minimal MT6855 recovery init for beryl.
# Vendor services/modules are handled by OrangeFox vendor-module loading.
#

on early-init
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/firmware 0755 root root

on fs
    symlink /vendor/firmware /vendor/odm/firmware

on boot
    setprop sys.usb.configfs 0
